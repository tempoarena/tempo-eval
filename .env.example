# Every environment variable tempo-eval reads. NAMES ONLY, never values.
# Copy to `.env` (gitignored). The shell wins over the file.

# Path to the private held-out seed file (YAML: {<game>: [seed, ...]}). Never commit it.
TEMPO_HELDOUT_SEEDS=

# Passed through to agent processes (tempo-baselines reads them):
# Jev (TypeSafe System One) for the jev and hybrid agents.
TYPESAFE_API_KEY=
# LLM agents use Bedrock via litellm with SigV4 from the standard AWS credential chain.
AWS_REGION=
TEMPO_LLM_MODEL=

# Where tempo-play is served, for the join URLs `tempo-eval play` prints.
TEMPO_PLAY_URL=
TEMPO_PLAY_PREVIEW_URL=
